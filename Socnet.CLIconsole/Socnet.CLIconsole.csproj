<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Application Metadata -->
    <Version>2.0.0</Version>
    <AssemblyName>Socnet</AssemblyName>
    <RootNamespace>Socnet.CLIconsole</RootNamespace>
    <Product>Socnet.se</Product>
    <Description>Socnet.se - the blockmodeling console app</Description>
    <Authors>Carl Nordlund</Authors>

    <!-- Build Configuration -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Supported Runtime Identifiers -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Socnet.Core\Socnet.Core.csproj" />
  </ItemGroup>
</Project>
